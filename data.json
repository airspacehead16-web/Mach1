  "articles": [
    {
      "id": "art-f1-aero",
      "section": "track",
      "seriesBadge": "F1",
      "tag": "ACTIVE AERODYNAMICS",
      "title": "2026 X-Mode & Z-Mode Wing Actuation: How Teams Balance Straight-Line Efficiency",
      "summary": "Front and rear multi-element flap synchronization is reshaping overtaking deltas and battery harvesting windows.",
      "author": "MACH1 Aerodynamics Desk",
      "date": "2026-11-20",
      "readTime": "5 MIN READ",
      "relatedTeamIds": [
        "t-mcl",
        "t-rbr",
        "t-fer"
      ],
      "relatedDriverIds": [
        "d-ver",
        "d-nor",
        "d-lec"
      ],
      "relatedAirlinerIds": [],
      "content": [
        "Under the 2026 FIA technical regulations, movable front and rear wing elements replace legacy DRS with unified X-Mode (low-drag straight-line) and Z-Mode (high-downforce cornering) configurations.",
        "Telemetry traces reveal that McLaren and Red Bull Racing trigger flap closure 35 metres later into heavy braking zones by pairing rapid hydraulic actuators with aggressive 350kW MGU-K harvest curves."
      ]
    },
    {
      "id": "art-fe-gen3",
      "section": "track",
      "seriesBadge": "FE",
      "tag": "POWERTRAIN TELEMETRY",
      "title": "GEN3 Evo All-Wheel-Drive Attack Mode: Front-Axle Torque Vectoring Explained",
      "summary": "Unlocking the front powertrain kit during Attack Mode drops 0–100 km/h sprint times to 1.86 seconds on street circuits.",
      "author": "MACH1 Electric Propulsion Desk",
      "date": "2026-11-18",
      "readTime": "4 MIN READ",
      "relatedTeamIds": [
        "t-fe-por",
        "t-fe-jag"
      ],
      "relatedDriverIds": [
        "d-fe-weh",
        "d-fe-eva"
      ],
      "relatedAirlinerIds": [],
      "content": [
        "By activating the front 250kW motor-generator unit alongside the rear 350kW axle during Attack Mode windows, GEN3 Evo cars achieve full four-wheel traction out of 90-degree street corners.",
        "Porsche and Jaguar engineers carefully balance front-axle mechanical grip against battery cell thermal rise over 38-lap race distances."
      ]
    },
    {
      "id": "art-sky-ge9x",
      "section": "sky",
      "seriesBadge": "AIRLINERS",
      "tag": "PROPULSION ENGINEERING",
      "title": "GE9X & Trent XWB: High-Bypass Turbofan Thermal Efficiency at Mach 0.85",
      "summary": "Ceramic matrix composites and 3.4-metre carbon fan blades push bypass ratios beyond 10:1 for ultra-long-haul routes.",
      "author": "MACH1 Aerospace Desk",
      "date": "2026-11-19",
      "readTime": "6 MIN READ",
      "relatedTeamIds": [],
      "relatedDriverIds": [],
      "relatedAirlinerIds": [
        "air-a350",
        "air-b777x"
      ],
      "content": [
        "Modern widebody propulsion relies on maximizing propulsive efficiency by accelerating a massive volume of bypass air at lower exit velocities.",
        "With 16 fourth-generation carbon-fiber composite fan blades and ceramic matrix composite (CMC) combustor liners, the GE9X on the Boeing 777-9 achieves a 10% specific fuel consumption improvement over its predecessor."
      ]
    },
    {
      "id": "art-sky-boom",
      "section": "sky",
      "seriesBadge": "AIRLINERS",
      "tag": "SUPERSONIC AERODYNAMICS",
      "title": "Area-Ruled Fuselage & Gull-Wing Geometry on Boom Overture",
      "summary": "Minimizing transonic wave drag at Mach 1.7 without energy-hungry afterburners.",
      "author": "MACH1 Aerospace Desk",
      "date": "2026-11-15",
      "readTime": "5 MIN READ",
      "relatedTeamIds": [],
      "relatedDriverIds": [],
      "relatedAirlinerIds": [
        "air-overture"
      ],
      "content": [
        "Sustained supersonic cruise at Mach 1.7 demands strict adherence to the Whitcomb area rule, tapering the fuselage waist where the gull-wing root cross-section peaks.",
        "Four non-afterburning Symphony medium-bypass turbofans allow Overture to meet Stage 5 airport noise standards while running on 100% Sustainable Aviation Fuel."
      ]
    }
  ],
